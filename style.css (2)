:root{--bg:#ECEEE6;--ink:#1E2621;--mute:#5E6A62;--line:#C9CFC2;--acc:#D9A400;--card:#F6F7F1}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#141A17;--ink:#E6EADF;--mute:#93A096;--line:#2D3832;--acc:#E8B90C;--card:#1B2420}}
:root[data-theme="dark"]{--bg:#141A17;--ink:#E6EADF;--mute:#93A096;--line:#2D3832;--acc:#E8B90C;--card:#1B2420}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:18px/1.6 Newsreader,Georgia,serif;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
header{padding:48px 20px 24px;max-width:720px;margin:0 auto;position:relative}
h1{font:800 clamp(40px,11vw,80px)/.95 'Bricolage Grotesque',system-ui,sans-serif;margin:0 0 14px;letter-spacing:-.03em}
header p{margin:0;color:var(--mute);max-width:46ch}
.theme-btn{position:absolute;top:20px;right:20px;background:var(--card);border:1px solid var(--line);color:var(--ink);width:44px;height:44px;border-radius:50%;cursor:pointer;font-size:20px;display:flex;align-items:center;justify-content:center}
.theme-btn:hover{border-color:var(--acc)}
nav{position:sticky;top:env(safe-area-inset-top,0px);background:var(--bg);border-bottom:1px solid var(--line);z-index:5}
nav div{max-width:720px;margin:0 auto;display:flex;overflow-x:auto;scrollbar-width:none}
nav div::-webkit-scrollbar{display:none}
nav button{flex:none;background:none;border:0;border-bottom:3px solid transparent;color:var(--mute);font:500 16px 'Bricolage Grotesque',system-ui,sans-serif;padding:14px 16px;cursor:pointer;white-space:nowrap}
nav button[aria-selected=true]{color:var(--ink);border-bottom-color:var(--acc)}
button:focus-visible,input:focus-visible,textarea:focus-visible,summary:focus-visible,a:focus-visible{outline:2px solid var(--acc);outline-offset:2px}
main{max-width:720px;margin:0 auto;padding:24px 20px 80px}
.intro{color:var(--mute);margin:0 0 20px}
details{border-bottom:1px solid var(--line);padding:4px 0}
summary{cursor:pointer;font:500 20px/1.3 'Bricolage Grotesque',system-ui,sans-serif;padding:14px 0;list-style:none;display:flex;justify-content:space-between;gap:12px;align-items:flex-start}
summary::-webkit-details-marker{display:none}
summary small{color:var(--mute);font:400 14px Newsreader,serif;white-space:nowrap;flex-shrink:0}
.body{white-space:pre-wrap;padding:0 0 12px;max-width:62ch}
.del{background:none;border:1px solid var(--line);color:var(--mute);border-radius:6px;padding:4px 10px;font:14px system-ui;cursor:pointer;margin-bottom:16px}
.del:hover{border-color:var(--acc);color:var(--ink)}
form{margin-top:32px;padding:18px;background:var(--card);border:1px solid var(--line);border-radius:10px;display:grid;gap:10px}
input,textarea{width:100%;background:var(--bg);color:var(--ink);border:1px solid var(--line);border-radius:6px;padding:10px 12px;font:inherit}
textarea{min-height:130px;resize:vertical}
form button{justify-self:start;background:var(--acc);color:#1E2621;border:0;border-radius:6px;padding:10px 18px;font:800 15px 'Bricolage Grotesque',system-ui,sans-serif;cursor:pointer}
.link-item{padding:14px 0;border-bottom:1px solid var(--line)}
.link-item a{font:500 18px 'Bricolage Grotesque',system-ui,sans-serif;color:var(--ink);text-decoration:none;border-bottom:2px solid var(--acc)}
.link-item a:hover{color:var(--acc)}
.link-item p{margin:6px 0 0;color:var(--mute);font-size:15px;word-break:break-all}
.cards{display:grid;gap:12px;margin:20px 0}
.card{display:block;padding:18px;background:var(--card);border:1px solid var(--line);border-radius:10px;text-decoration:none;color:var(--ink);transition:border-color .2s;cursor:pointer}
.card:hover{border-color:var(--acc)}
.card h3{margin:0 0 6px;font:800 20px 'Bricolage Grotesque',system-ui,sans-serif}
.card p{margin:0;color:var(--mute);font-size:15px}
footer{max-width:720px;margin:0 auto;padding:20px;color:var(--mute);font-size:13px;border-top:1px solid var(--line)}
footer a{color:var(--mute)}
@media(max-width:520px){header{padding:36px 16px 20px}h1{font-size:clamp(36px,12vw,60px)}main{padding:20px 16px 60px}}
